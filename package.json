{
  "name": "cota",
  "version": "0.1.0",
  "private": true,
  "description": "A local, terminal-first macOS workspace",
  "license": "BSD-3-Clause",
  "author": "chaoting lin",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:pty": "node scripts/pty-smoke.cjs",
    "test:host": "pnpm build && node scripts/host-smoke.cjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "pack": "pnpm build && electron-builder --mac --arm64 --dir",
    "dist": "pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-grab": "^0.1.37",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.8.0"
}
