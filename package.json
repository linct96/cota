{
  "name": "cota",
  "version": "0.1.0",
  "private": true,
  "description": "A local, terminal-first desktop workspace",
  "license": "BSD-3-Clause",
  "author": "chaoting lin",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:pty": "node scripts/pty-smoke.cjs",
    "test:host": "pnpm build && node scripts/host-smoke.cjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "pnpm lint && pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && node scripts/install-app-deps.cjs",
    "pack": "pnpm build && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "pnpm run dist --mac --arm64",
    "dist:win": "pnpm run dist --win --x64"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/icons": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.45",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-ligatures": "0.11.0-beta.310",
    "@xterm/addon-serialize": "0.15.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/headless": "6.1.0-beta.313",
    "@xterm/xterm": "6.1.0-beta.315",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "koffi": "3.3.3",
    "lucide-react": "^1.58.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.6",
    "shadcn": "^4.21.5",
    "simple-icons": "12.4.0",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.8.0"
}
